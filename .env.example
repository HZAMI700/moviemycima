# Environment Variables for WeCima Metadata Crawler
# Copy to .env and fill in values if needed

# Start URL for crawling
START_URL=https://wecima.bid

# Max pages to crawl (0 = unlimited)
MAX_PAGES=100

# Max crawl depth (0 = unlimited)
MAX_DEPTH=3

# Delay between requests in seconds (min,max)
REQUEST_DELAY_MIN=2
REQUEST_DELAY_MAX=5

# Output files
OUTPUT_JSONL=data/output.jsonl
OUTPUT_CSV=data/output.csv
OUTPUT_SQLITE=data/metadata.sqlite

# User-Agent override (optional)
# USER_AGENT=Mozilla/5.0...
